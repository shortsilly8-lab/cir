#6A Write a program to check whether a number is a palindrome or not using a user defined function with a return statement. 

palindrome_func <- function(number) { 
num <- number 
a <- 0 
while (num != 0) { 
c <- num %% 10 
a <- a * 10 + c 
num <- as.integer(num / 10) 
} 
if (number == a) { 
return("Its a palindrome !") 
} else { 
return("Not a palindrome ..!") 
} 
}  
