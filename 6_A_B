#6B Write a program to check factorial and prime number using user defined functions with a return statement. 
factorial_func <- function(number) { 
num <- number 
fact <- 1 
for (i in num:1) { 
fact <- fact * i 
} 
return(fact) 
}  
prime_func <- function(number) { 
if (number < 2) { 
return("Not a prime !!!") 
} 
flag_ctf <- FALSE 
if (number > 2) { 
for (i in 2:(number - 1)) { 
if (number %% i == 0) { 
flag_ctf <- TRUE 
break 
} 
} 
} 
if (flag_ctf == TRUE) { 
return("Not a prime") 
} else { 
return("Prime number") 
} 
}  
n <- 11 
print(prime_func(n)) 
print(factorial_func(n)) 
