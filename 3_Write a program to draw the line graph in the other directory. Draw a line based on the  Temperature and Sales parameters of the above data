#3 Write a program to draw the line graph in the other directory. Draw a line based on the Temperature and Sales parameters of the above data.

temp <- data.frame(
  Date = c("1/1/2017", "1/2/2017", "1/3/2017", "1/4/2017", "1/5/2017"),
  Day = c("Sunday", "Monday", "Tuesday", "Wednesday", "Thursday"),
  Temperature = c(8, 12, 22, 3, 31),
  Rainfall = c(2.00, 1.33, 1.33, 1.05, 1.00),
  Flyers = c(15, 15, 17, 28, 33),
  Price = c(0.3, 0.3, 0.3, 0.3, 0.3),
  Sales = c(12, 5, 6, 16, 7)
)
write.csv(temp, "temp.csv", row.names = FALSE)
print("Data files successfully created!")

data <- read.csv("temp.csv") 
print(data)  
t <- data[, c("Temperature")] 
s <- data[, c("Sales")] 
print(t) 
print(s)  
png(file = "Sales_Temp_Line.png")  
plot(t, type = "o", col = "red", xlab = "Day", ylab = "Temperature / Sales", 
main = "Sales & Temperature", ylim = range(c(t, s))) 
lines(s, type = "o", col = "blue") 
legend("topleft", c("Temperature", "Sales"), col = c("red", "blue"), 
lty = 1, pch = 1, cex = 0.8)  
dev.off()
