#8 Use Covid data and perform the following: 

#1. Compare the total Covid cases of one month (April 2020) for 5 states and show the state with the best recovery percentage 
rm(list = ls()) 
data1 <- read.csv("covid_state.csv") 
print(data1)  
states  <- c("MH", "AP", "AR", "AS", "BR") 
labels1 <- c("Maharashtra", "Andhra Pradesh", "Arunachal Pradesh", "Assam", "Bihar")  
# Recovery percentage of each state for April 2020 
rec_per <- numeric(length(states)) 
for (k in 1:length(states)) { 
st <- subset(data1, State == states[k] & as.Date(c_date) >= as.Date("2020-04-01") & as.Date(c_date) <= as.Date("2020-04-30")) 
rec_per[k] <- (sum(st$Recovered) / sum(st$tot_cases)) * 100 
} 
print(rec_per)  
best <- which.max(rec_per) 
cat(labels1[best], "is the best state with a recovery rate of", max(rec_per), ".\n")  
# Pie chart of the recovery percentages 
x <- round(rec_per, 2) 
png(file = "State_Recovery_Pie_Chart.png") 
pie(x, labels = x, main = "State Recovery Pie Chart", col = rainbow(length(x))) 
legend("topright", labels1, cex = 0.6, fill = rainbow(length(x))) 
dev.off() 


#2. Compare cases raised from the previous month (April) to the current month (May) – Maharashtra 
rm(list = ls()) 
data1 <- read.csv("covid_state.csv")  
mh_april <- subset(data1, State == "MH" & as.Date(c_date) >= as.Date("2020-04-01") & as.Date(c_date) <= as.Date("2020-04-30")) 
mh_may <- subset(data1, State == "MH" & as.Date(c_date) >= as.Date("2020-05-01") & as.Date(c_date) <= as.Date("2020-05-31"))  
cases_april <- sum(mh_april$tot_cases) 
cases_may <- sum(mh_may$tot_cases) 
print(cases_april) 
print(cases_may)  
cases_raised <- cases_may - cases_april 
cat("Difference in cases from April to May is", cases_raised, ".\n")  
# Line chart comparing the two months 
png(file = "Cases_comparison_April_May.png") 
plot(mh_april$tot_cases, type = "o", col = "red", xlab = "Month", 
ylab = "Total Cases", main = "Total Cases Chart month-wise") 
lines(mh_may$tot_cases, type = "o", col = "blue") 
dev.off() 


#3. Plot a pie chart / histogram of total cases, recovered cases and total tests [Maharashtra only] 
data1 <- read.csv("covid_state.csv")  
mh_apr <- subset(data1, State == "MH" & as.Date(c_date) >= as.Date("2020-04-01") & as.Date(c_date) <= as.Date("2020-04-30")) 
